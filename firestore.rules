rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users collection (Band Directors & Student Musician profiles)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if 
        request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.role in ['admin', 'student'];
      allow delete: if true;

      // Private sensitive subcollection
      match /private/{docId} {
        allow read, write: if true;
      }
    }

    // 2. Bands collection
    match /bands/{bandId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /announcements/{annId} {
        allow read, write: if true;
      }

      match /songs/{songId} {
        allow read, write: if true;

        match /votes/{userId} {
          allow read, write: if true;
        }
      }
    }

    // 3. Rehearsal Events
    match /rehearsals/{eventId} {
      allow read, write: if true;
    }

    // 4. Invites & QR passes
    match /invites/{code} {
      allow read, write: if true;
    }

    // 5. Direct Messages (1-on-1 private messaging)
    match /direct_messages/{conversationId}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
